# Cloudflare Pages : /en et /es servent la même app (une seule page), qui lit la langue dans l’adresse
/en /index.html 200
/en/* /index.html 200
/es /index.html 200
/es/* /index.html 200
# Mentions légales : même slug dans toutes les langues
/legals /index.html 200
# Défi du jour : même slug dans toutes les langues
/daily /index.html 200
